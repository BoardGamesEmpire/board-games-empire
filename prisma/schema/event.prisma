model Event {
  id          String    @id @default(cuid(2))
  household   Household @relation(fields: [householdId], references: [id])
  householdId String    @map("household_id")
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String    @map("created_by_id")

  title       String
  image       String?
  description String?
  location    String?
  url         String?

  visibility        Visibility @default(Friends)
  allowGuestInvites Boolean    @default(true) @map("allow_guest_invites")

  memberPermissions EventMemberPermission[]

  maxTotalParticipants Int?    @map("max_total_participants")
  strictCapacity       Boolean @default(false) @map("strict_capacity")

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date") @db.Timestamptz(3)

  gamePlaySessions GamePlaySession[]
  attendees        EventAttendee[]
  votedGames       EventGameVote[]
  invites          EventInvite[]
  suggestedGames   EventGame[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("events")
}

model EventAttendee {
  id      String @id @default(cuid(2))
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @map("event_id")

  attendeeType AttendeeType @default(Participant) @map("attendee_type")

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @map("user_id")

  // For guests without accounts
  guestName  String? @map("guest_name")
  guestEmail String? @map("guest_email")

  status EventParticipationStatus @default(Invited)
  role   EventParticipantRole     @default(Participant)

  invitedBy   EventAttendee? @relation("InvitedAttendees", fields: [invitedById], references: [id])
  invitedById String?        @map("invited_by_id")

  invitees EventAttendee[] @relation("InvitedAttendees")

  gamesContributing EventGame[]

  notes    String?
  rsvpDate DateTime? @map("rsvp_date") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_attendees")
}

model EventGameVote {
  id          String    @id @default(cuid(2))
  eventGame   EventGame @relation(fields: [eventGameId], references: [id])
  eventGameId String    @map("event_game_id")
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @map("user_id")
  Event       Event?    @relation(fields: [eventId], references: [id])
  eventId     String?   @map("event_id")

  @@unique([eventGameId, userId])
  @@map("event_game_votes")
}

model EventGame {
  id      String @id @default(cuid(2))
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @map("event_id")
  game    Game   @relation(fields: [gameId], references: [id])
  gameId  String @map("game_id")

  suggestedBy   EventAttendee @relation(fields: [suggestedById], references: [id])
  suggestedById String        @map("suggested_by_id")

  votes EventGameVote[]

  @@map("event_games")
}

model EventMemberPermission {
  id      String @id @default(cuid(2))
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @map("event_id")
  user    User   @relation(fields: [userId], references: [id])
  userId  String @map("user_id")

  permission Permission

  grantedBy   User   @relation("EventPermissionGranter", fields: [grantedById], references: [id])
  grantedById String @map("granted_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventId, userId, permission])
  @@map("event_member_permissions")
}

enum EventParticipantRole {
  CoHost
  Guest
  Host
  Moderator
  Organizer
  Participant
  Spectator

  @@map("event_participant_roles")
}

enum EventParticipationStatus {
  Attending
  Invited
  Maybe
  NotAttending

  @@map("event_participation_statuses")
}

enum AttendeeType {
  Participant
  Guest
  Organizer

  @@map("attendee_types")
}
