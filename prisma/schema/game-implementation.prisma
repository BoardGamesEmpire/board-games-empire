model GameImplementation {
  id String @id @default(cuid(2))

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  gameGateway                   GameGateway? @relation(fields: [gameGatewayId], references: [id])
  gameGatewayId                 String?                 @map("game_gateway_id")
  externalSourceIdentifier String?                 @map("external_source_identifier")

  platform GamePlatform
  title    String?
  url      String?

  publisher   Publisher? @relation(fields: [publisherId], references: [id])
  publisherId String?    @map("publisher_id")

  releaseDate DateTime? @map("release_date") @db.Timestamptz(3)
  version     String?
  lastUpdated DateTime? @map("last_updated") @db.Timestamptz(3)

  pricingModel   PricingModel? @map("pricing_model")
  basePrice      Float?        @map("base_price")
  hasPurchases   Boolean       @default(false) @map("has_purchases")
  isSubscription Boolean       @default(false) @map("is_subscription")

  supportsSolo   Boolean @default(false) @map("supports_solo")
  supportsLocal  Boolean @default(false) @map("supports_local")
  supportsOnline Boolean @default(false) @map("supports_online")
  hasAsyncPlay   Boolean @default(false) @map("has_async_play")
  hasRealtime    Boolean @default(false) @map("has_realtime")
  hasTutorial    Boolean @default(false) @map("has_tutorial")

  userRatings ImplementationRating[]

  storeIdentifiers Json? @map("store_identifiers")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gameId, platform])
  @@map("game_implementations")
}

model ImplementationRating {
  id               String             @id @default(cuid(2))
  implementation   GameImplementation @relation(fields: [implementationId], references: [id])
  implementationId String             @map("implementation_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  rating          Float
  review          String?
  usabilityRating Float?  @map("usability_rating")
  featureRating   Float?  @map("feature_rating")
  aiRating        Float?  @map("ai_rating")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([implementationId, userId])
  @@map("implementation_ratings")
}

enum GamePlatform {
  Android
  BoardGameArena
  EpicGames
  iOS
  OtherDigital
  PhysicalOnly
  PlayStation
  Steam
  Switch
  Tabletopia
  TabletopSimulator
  Vassal
  WebBased
  Xbox

  @@map("game_platforms")
}

enum PricingModel {
  Free
  Freemium
  Mixed
  PaidUpfront
  Subscription

  @@map("pricing_models")
}
