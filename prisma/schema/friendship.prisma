model Friendship {
  id String @id @default(cuid(2))

  requestor   User   @relation("FriendshipRequestor", fields: [requestorId], references: [id])
  requestorId String @map("requestor_id")
  recipient   User   @relation("FriendshipRecipient", fields: [recipientId], references: [id])
  recipientId String @map("recipient_id")

  status FriendshipStatus @default(Pending) @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([requestorId, recipientId])
  @@map("friendships")
}

enum FriendshipStatus {
  Accepted
  Blocked
  Declined
  Pending
  Unfriended

  @@map("friendship_statuses")
}
