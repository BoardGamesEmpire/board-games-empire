model Token {
  id String @id @default(cuid(2))

  type  TokenType
  token String    @unique @db.VarChar(512)

  authentication   UserAuthentication @relation(fields: [authenticationId], references: [id])
  authenticationId String             @map("authentication_id")

  isRevoked Boolean @default(false) @map("is_revoked")
  isUsed    Boolean @default(false) @map("is_used")

  revocationReason String? @map("revocation_reason") @db.VarChar(255)

  metadata Json?

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tokens")
}

enum TokenType {
  Access
  Refresh
  EmailVerification
  PasswordReset
  SessionReference

  @@map("token_types")
}
