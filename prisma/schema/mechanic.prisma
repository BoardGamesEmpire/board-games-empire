model Mechanic {
  id          String         @id @default(cuid(2))
  name        String         @unique
  description String? // Added description field
  complexity  Int? // Optional 1-10 complexity rating
  games       GameMechanic[]

  // Related mechanics
  similarMechanics MechanicRelationship[] @relation("PrimaryMechanic")
  similarTo        MechanicRelationship[] @relation("RelatedMechanic")

  // New metadata for network analysis
  usageCount         Int? // How many games use this mechanic
  compatibilityScore Float? // How well this mechanic works with others (0-1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("mechanics")
}

// Model for related mechanics
model MechanicRelationship {
  id                String   @id @default(cuid(2))
  primaryMechanic   Mechanic @relation("PrimaryMechanic", fields: [primaryMechanicId], references: [id])
  primaryMechanicId String
  relatedMechanic   Mechanic @relation("RelatedMechanic", fields: [relatedMechanicId], references: [id])
  relatedMechanicId String

  // Relationship details
  relationshipType MechanicRelationshipType
  strength         Float // 0-1 score indicating relationship strength
  description      String? // Optional explanation of the relationship

  // Who established this relationship
  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  // Validation metrics
  communityRating Float? // Community agreement with relationship (0-1)
  supportEvidence String? // Evidence supporting this relationship (e.g., games using both)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([primaryMechanicId, relatedMechanicId, relationshipType])
  @@index([primaryMechanicId])
  @@index([relatedMechanicId])
  @@map("mechanic_relationships")
}

enum MechanicRelationshipType {
  Alternative // Mechanics that serve similar purposes
  Complementary // Mechanics that work well together
  Conflicting // Mechanics that are difficult to combine
  Evolution // One evolved from the other
  Prerequisite // One mechanic requires the other
  Similar // Mechanics that are conceptually similar
  SubMechanic // One is a specialized version of the other

  @@map("mechanic_relationship_types")
}

model GameMechanic {
  id         String   @id @default(cuid(2))
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @db.Timestamptz(3)
  game       Game     @relation(fields: [gameId], references: [id])
  gameId     String
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id])
  mechanicId String

  @@unique([gameId, mechanicId])
  @@map("game_mechanics")
}
