model Mechanic {
  id          String         @id @default(cuid(2))
  name        String         @unique
  description String?
  complexity  Int?
  games       GameMechanic[]

  similarMechanics MechanicRelationship[] @relation("PrimaryMechanic")
  similarTo        MechanicRelationship[] @relation("RelatedMechanic")

  usageCount         Int?   @map("usage_count")
  compatibilityScore Float? @map("compatibility_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mechanics")
}

model MechanicRelationship {
  id                String   @id @default(cuid(2))
  primaryMechanic   Mechanic @relation("PrimaryMechanic", fields: [primaryMechanicId], references: [id])
  primaryMechanicId String   @map("primary_mechanic_id")
  relatedMechanic   Mechanic @relation("RelatedMechanic", fields: [relatedMechanicId], references: [id])
  relatedMechanicId String   @map("related_mechanic_id")

  relationshipType MechanicRelationshipType @map("relationship_type")
  strength         Float
  description      String?

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String? @map("created_by_id")

  communityRating Float?  @map("community_rating")
  supportEvidence String? @map("support_evidence")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([primaryMechanicId, relatedMechanicId, relationshipType])
  @@index([primaryMechanicId])
  @@index([relatedMechanicId])
  @@map("mechanic_relationships")
}

enum MechanicRelationshipType {
  Alternative
  Complementary
  Conflicting
  Evolution
  Prerequisite
  Similar
  SubMechanic

  @@map("mechanic_relationship_types")
}

model GameMechanic {
  id         String   @id @default(cuid(2))
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  game       Game     @relation(fields: [gameId], references: [id])
  gameId     String   @map("game_id")
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id])
  mechanicId String   @map("mechanic_id")

  @@unique([gameId, mechanicId])
  @@map("game_mechanics")
}
