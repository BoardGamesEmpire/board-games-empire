model GameWeight {
  id     String @id @default(cuid(2))
  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @unique @map("game_id")

  overallWeight Float? @map("overall_weight")

  rulesWeight    Float? @map("rules_weight")
  strategyWeight Float? @map("strategy_weight")
  luckWeight     Float? @map("luck_weight")
  mathWeight     Float? @map("math_weight")
  socialWeight   Float? @map("social_weight")

  teachingTime  Int?           @map("teaching_time")
  learningCurve LearningCurve? @map("learning_curve")

  weightSource WeightSource @default(Internal) @map("weight_source")
  externalUrl  String?      @map("external_url")

  weightVotes GameWeightVote[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("game_weights")
}

model GameWeightVote {
  id           String     @id @default(cuid(2))
  gameWeight   GameWeight @relation(fields: [gameWeightId], references: [id])
  gameWeightId String     @map("game_weight_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  overallWeight  Float? @map("overall_weight")
  rulesWeight    Float? @map("rules_weight")
  strategyWeight Float? @map("strategy_weight")
  luckWeight     Float? @map("luck_weight")
  mathWeight     Float? @map("math_weight")
  socialWeight   Float? @map("social_weight")

  comments String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gameWeightId, userId])
  @@map("game_weight_votes")
}

enum WeightSource {
  Internal
  BoardGameGeek
  UserAverage
  ExpertRating

  @@map("weight_sources")
}

enum LearningCurve {
  Gentle
  Moderate
  Stepped
  Steep
  Cliff

  @@map("learning_curves")
}
