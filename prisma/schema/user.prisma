model User {
  id String @id @default(cuid(2))

  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  avatar       String?
  profileImage String? @map("profile_image")
  username     String  @unique
  bio          String?

  authentication UserAuthentication?

  mechanicRelationships MechanicRelationship[]
  gameWeightVotes       GameWeightVote[]
  implementationRatings ImplementationRating[]
  familyCollections     FamilyCollection[]

  gameMedia GameMedia[]

  roles             UserRole[]
  householdRoles    HouseholdRole[]
  directPermissions UserPermission[]
  permissionGroups  GroupMember[]

  grantedPermissions         UserPermission[]           @relation("PermissionGranter")
  grantedCampaignPermissions CampaignMemberPermission[] @relation("CampaignPermissionGranter")
  grantedEventPermissions    EventMemberPermission[]    @relation("EventPermissionGranter")

  campaignPermissions CampaignMemberPermission[]
  eventPermissions    EventMemberPermission[]

  tagsAdded    GameTag[]
  achievements UserAchievement[]

  friendshipRequestsSent     Friendship[] @relation("FriendshipRequestor")
  friendshipRequestsReceived Friendship[] @relation("FriendshipRecipient")

  preferences UserPreferences?

  householdMembers HouseholdMember[]
  households       Household[]

  campaignsRunning Campaign[]          @relation("CampaignGameMaster")
  characters       CampaignCharacter[]

  createdRuleVariants RuleVariant[]

  gameCollection GameCollection[]
  lists          List[]

  gameReviews GameReview[]

  gamePlayParticipation GamePlayParticipant[]
  eventGameVotes        EventGameVote[]
  events                Event[]

  gamesOnLoan   GameLoan[] @relation("GamesOnLoan")
  gamesLoanedTo GameLoan[] @relation("GamesLoanedTo")

  receivedInvites EventInvite[]
  sentInvites     EventInvite[]   @relation("SentInvites")
  attendees       EventAttendee[]

  championedGames    HouseholdGame[]           @relation("GameChampion")
  maintainedGames    HouseholdGame[]           @relation("GameKeeper")
  teacherForGames    HouseholdGame[]           @relation("GameTeacher")
  createdExperiences HouseholdGameExperience[]

  notifications Notification[]

  sessionMediaUploaded SessionMedia[]

  gameCustomizations          UserGameCustomization[]
  householdCustomizationsMade HouseholdGameCustomization[]
  gamesCreated                Game[]                       @relation("GamesCreated")

  userGameCustomizationPermissions    UserGameCustomizationPermission[]
  grantedUserCustomizationPermissions UserGameCustomizationPermission[] @relation("CustomizationPermissionGranter")

  householdGameCustomizationPermissions    HouseholdGameCustomizationPermission[]
  grantedHouseholdCustomizationPermissions HouseholdGameCustomizationPermission[] @relation("HouseholdCustomizationPermissionGranter")

  accessToGames        GameUserAccess[]
  sharedGames          GameUserAccess[]      @relation("GameSharer")
  sharedWithHouseholds GameHouseholdAccess[] @relation("HouseholdGameSharer")

  policyAssignments     UserPolicyAssignment[]
  resourcePolicyTargets ResourcePolicyAssignment[]
  createdPolicies       PermissionPolicy[]         @relation("PolicyCreator")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model UserPreferences {
  id     String @id @default(cuid(2))
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @map("user_id")

  // Theme preferences
  theme       String  @default("system") @map("theme") // light, dark, system
  accentColor String? @map("accent_color")

  // Privacy preferences
  showOnlineStatus        Boolean @default(true) @map("show_online_status")
  showLastActive          Boolean @default(true) @map("show_last_active")
  allowFriendRequests     Boolean @default(true) @map("allow_friend_requests")
  showCollectionToFriends Boolean @default(true) @map("show_collection_to_friends")
  showGamePlayHistory     Boolean @default(true) @map("show_game_play_history")

  // Notification preferences
  emailNotifications Json? @map("email_notifications") // Structured notification preferences
  pushNotifications  Json? @map("push_notifications")

  // Game preferences
  preferredPlayerCount Int?     @map("preferred_player_count")
  preferredGameLength  Int?     @map("preferred_game_length") // In minutes
  favoriteCategories   String[] @map("favorite_categories")
  favoriteMechanics    String[] @map("favorite_mechanics")
  dislikedCategories   String[] @map("disliked_categories")
  dislikedMechanics    String[] @map("disliked_mechanics")

  language                Language?  @relation(fields: [languageId], references: [id])
  languageId              String?    @map("language_id")
  defaultReviewVisibility Visibility @default(Private) @map("default_review_visibility")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_preferences")
}

model UserRole {
  id     String @id @default(cuid(2))
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")
  role   Role   @relation(fields: [roleId], references: [id])
  roleId String @map("role_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  id     String @id @default(cuid(2))
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  permission Permission @map("permission")

  resourceType ResourceType @map("resource_type")
  resourceId   String?      @map("resource_id")

  grantedBy   User      @relation("PermissionGranter", fields: [grantedById], references: [id])
  grantedById String    @map("granted_by_id")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, permission, resourceType, resourceId])
  @@map("user_permissions")
}

model UserLoginHistory {
  id String @id @default(cuid(2))

  authentication   UserAuthentication @relation(fields: [authenticationId], references: [id])
  authenticationId String             @map("authentication_id")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  success   Boolean @default(true)

  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("user_login_histories")
}

model UserDevice {
  id String @id @default(cuid(2))

  authentication   UserAuthentication @relation(fields: [authenticationId], references: [id])
  authenticationId String             @map("authentication_id")

  deviceName       String?  @map("device_name")
  deviceIdentifier String   @map("device_identifier")
  lastUsed         DateTime @default(now()) @map("last_used") @db.Timestamptz(3)
  isTrusted        Boolean  @default(false) @map("is_trusted")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([authenticationId, deviceIdentifier])
  @@map("user_devices")
}

model UserGameCustomization {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  title       String? @map("title")
  subtitle    String? @map("subtitle")
  description String? @map("description")
  image       String? @map("image")
  publishYear Int?    @map("publish_year")

  minPlayers Int? @map("min_players")
  maxPlayers Int? @map("max_players")

  playingTime Int? @map("playing_time")
  minPlayTime Int? @map("min_play_time")
  maxPlayTime Int? @map("max_play_time")

  minAge     Int?   @map("min_age")
  complexity Float? @map("complexity")

  customizationNotes String? @map("customization_notes")

  permissions UserGameCustomizationPermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, gameId])
  @@map("user_game_customizations")
}

model UserGameCustomizationPermission {
  id String @id @default(cuid(2))

  customization   UserGameCustomization @relation(fields: [customizationId], references: [id])
  customizationId String                @map("customization_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  permission Permission @map("permission")

  grantedBy   User   @relation("CustomizationPermissionGranter", fields: [grantedById], references: [id])
  grantedById String @map("granted_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([customizationId, userId, permission])
  @@map("user_game_customization_permissions")
}

model UserAchievement {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId String      @map("achievement_id")

  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)
  progress Int      @default(0) @map("progress") // Progress toward multi-step achievements

  @@unique([userId, achievementId])
  @@map("user_achievements")
}
