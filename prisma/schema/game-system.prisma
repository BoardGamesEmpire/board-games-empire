model GameSystem {
  id          String  @id @default(cuid())
  name        String  @unique // D&D 5e, Pathfinder, etc.
  publisher   String? // Wizards of the Coast, Paizo, etc.
  version     String? // Version or edition (5e, 2e, etc.)
  description String?

  // Game System Mechanics
  attributeSchema Json? // Define character attributes for this system
  classOptions    Json? // Available classes/archetypes
  raceOptions     Json? // Available races/species

  // Campaigns using this system
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("game_systems")
}
