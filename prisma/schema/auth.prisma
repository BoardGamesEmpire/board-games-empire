model IdentityProvider {
  id       String @id @default(cuid(2))
  name     String @unique
  provider String @unique

  clientId         String  @map("client_id")
  clientSecret     String  @map("client_secret")
  discoveryUrl     String? @map("discovery_url")
  authorizationUrl String? @map("authorization_url")
  tokenUrl         String? @map("token_url")
  userInfoUrl      String? @map("user_info_url")
  jwksUrl          String? @map("jwks_url")

  scopes  String[] @default(["openid", "email", "profile", "offline_access"]) @map("scopes")
  enabled Boolean  @default(true)

  identities UserExternalIdentity[]

  authSessions OidcAuthSession[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("identity_providers")
}

model UserExternalIdentity {
  id String @id @default(cuid(2))

  authentication   UserAuthentication @relation(fields: [authenticationId], references: [id])
  authenticationId String             @map("authentication_id")

  provider   IdentityProvider @relation(fields: [providerId], references: [id])
  providerId String           @map("provider_id")

  externalId     String    @map("external_id")
  email          String?
  rawProfile     Json?     @map("raw_profile")
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, externalId])
  @@map("user_external_identities")
}

model OidcAuthSession {
  id String @id @default(cuid(2))

  state        String  @unique
  nonce        String?
  codeVerifier String? @map("code_verifier")
  redirectUri  String  @map("redirect_uri")

  authentication   UserAuthentication? @relation(fields: [authenticationId], references: [id])
  authenticationId String?             @map("authentication_id")

  provider   IdentityProvider @relation(fields: [providerId], references: [id])
  providerId String           @map("provider_id")

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("oidc_auth_sessions")
}

model UserSession {
  id               String             @id @default(cuid(2))
  authentication   UserAuthentication @relation(fields: [authenticationId], references: [id], onDelete: Cascade)
  authenticationId String             @map("authentication_id")

  token      String   @unique
  deviceInfo Json?    @map("device_info")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  lastActive DateTime @default(now()) @map("last_active")
  expiresAt  DateTime @map("expires_at")
  isValid    Boolean  @default(true) @map("is_valid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([token])
  @@index([authenticationId, isValid])
  @@map("user_sessions")
}

model UserAuthentication {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @map("user_id")

  email        String       @unique
  password     String?
  authStrategy AuthStrategy @default(Local) @map("auth_strategy")

  emailVerified Boolean @default(false) @map("email_verified")

  lastPasswordChange DateTime? @map("last_password_change") @db.Timestamptz(3)

  accountLocked       Boolean   @default(false) @map("account_locked")
  accountLockedUntil  DateTime? @map("account_locked_until") @db.Timestamptz(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLogin     DateTime? @map("last_failed_login") @db.Timestamptz(3)
  lastLogin           DateTime? @map("last_login") @db.Timestamptz(3)

  twoFactorEnabled  Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret   String? @map("two_factor_secret")
  recoveryCodesHash String? @map("recovery_codes_hash")

  isExternalUser     Boolean                @default(false) @map("is_external_user")
  externalIdentities UserExternalIdentity[]
  oidcSessions       OidcAuthSession[]

  loginHistory UserLoginHistory[]
  sessions     UserSession[]
  knownDevices UserDevice[]
  tokens       Token[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_authentications")
}

enum AuthStrategy {
  Apple
  Custom
  Facebook
  GitHub
  Google
  Local
  Microsoft

  @@map("auth_strategies")
}
