model IdentityProvider {
  id             String    @id @default(cuid(2))
  name           String    @unique             // Display name (e.g., "Google")
  provider       String    @unique             // Provider identifier (e.g., "google")

  // OIDC configuration
  clientId       String                        // OIDC client ID
  clientSecret   String                        // OIDC client secret (should be encrypted)
  discoveryUrl   String?                       // OIDC discovery URL
  authorizationUrl String?                     // Authorization endpoint URL
  tokenUrl       String?                       // Token endpoint URL
  userInfoUrl    String?                       // UserInfo endpoint URL
  jwksUrl        String?                       // JWKS endpoint URL

  // Provider configuration
  scopes         String[]  @default(["openid", "email", "profile"]) // Requested scopes
  enabled        Boolean   @default(true)      // Whether this provider is active

  // External identities using this provider
  identities     UserExternalIdentity[]

  // sessions
  authSessions   OidcAuthSession[]

  // Timestamps
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@map("identity_providers")
}

model UserExternalIdentity {
  id             String    @id @default(cuid(2))

  // User association
  authentication   UserAuthentication @relation(fields: [authenticationId], references: [id])
  authenticationId String

  // Provider association
  provider       IdentityProvider @relation(fields: [providerId], references: [id])
  providerId     String

  // Identity details
  externalId     String            // User ID at the external provider
  email          String?           // Email from the provider (may differ from user.email)
  rawProfile     Json?             // Raw profile data from provider
  accessToken    String?           // Encrypted access token
  refreshToken   String?           // Encrypted refresh token
  tokenExpiresAt DateTime? @db.Timestamptz(3)         // When the token expires

  // Timestamps
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, externalId])  // Each external ID can only be linked once per provider
  @@map("user_external_identities")
}

model OidcAuthSession {
  id             String    @id @default(cuid(2))

  // Session details
  state          String    @unique   // OIDC state parameter for validation
  nonce          String?             // OIDC nonce parameter for validation
  codeVerifier   String?             // PKCE code verifier
  redirectUri    String              // Where to redirect after auth

  // User association - optional to allow flow initiation
  authentication   UserAuthentication? @relation(fields: [authenticationId], references: [id])
  authenticationId String?

  // Provider details
  provider       IdentityProvider @relation(fields: [providerId], references: [id])
  providerId     String

  // Session expiration
  expiresAt      DateTime           // When this session expires

  // Timestamps
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@map("oidc_auth_sessions")
}

model UserSession {
  id                String             @id @default(cuid(2))
  authentication    UserAuthentication @relation(fields: [authenticationId], references: [id], onDelete: Cascade)
  authenticationId  String

  // Session metadata
  token             String             @unique // Will store JWT reference
  deviceInfo        Json?              // Browser, OS, etc.
  ipAddress         String?
  userAgent         String?
  lastActive        DateTime           @default(now())
  expiresAt         DateTime
  isValid           Boolean            @default(true)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([token])
  @@index([authenticationId, isValid])
  @@map("user_sessions")
}

model UserAuthentication {
  id            String       @id @default(cuid(2))

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String       @unique

  // Credentials
  email         String       @unique
  password      String?
  authStrategy  AuthStrategy @default(Local)

  // Email verification
  emailVerified Boolean      @default(false)

  lastPasswordChange DateTime? @db.Timestamptz(3)

  // Security features
  accountLocked Boolean      @default(false)
  accountLockedUntil DateTime? @db.Timestamptz(3)
  failedLoginAttempts Int    @default(0)
  lastFailedLogin DateTime? @db.Timestamptz(3)
  lastLogin      DateTime? @db.Timestamptz(3)

  // 2FA
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret String?
  recoveryCodesHash String?

  // External identity management
  isExternalUser Boolean     @default(false)
  externalIdentities UserExternalIdentity[]
  oidcSessions    OidcAuthSession[]

  // Devices and sessions
  loginHistory    UserLoginHistory[]
  sessions        UserSession[]
  knownDevices    UserDevice[]
  tokens          Token[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("user_authentications")
}

enum AuthStrategy {
  Apple          // Apple OIDC
  Custom         // Custom OIDC provider
  Facebook       // Facebook OIDC
  GitHub         // GitHub OIDC
  Google         // Google OIDC
  Local          // Traditional email/password
  Microsoft      // Microsoft OIDC

  @@map("auth_strategies")
}
