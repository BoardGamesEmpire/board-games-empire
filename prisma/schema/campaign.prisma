model Campaign {
  id          String  @id @default(cuid(2))
  name        String
  description String?
  image       String?

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  status    CampaignStatus @default(Active) @map("status")
  startDate DateTime       @default(now()) @map("start_date") @db.Timestamptz(3)
  endDate   DateTime?      @map("end_date") @db.Timestamptz(3)

  household   Household @relation(fields: [householdId], references: [id])
  householdId String    @map("household_id")

  gameMaster   User   @relation("CampaignGameMaster", fields: [gameMasterId], references: [id])
  gameMasterId String @map("game_master_id")

  sessions GamePlaySession[]

  characters CampaignCharacter[]

  currentLevel   Int?    @map("current_level")
  currentChapter String? @map("current_chapter")
  campaignNotes  String? @map("campaign_notes")

  memberPermissions CampaignMemberPermission[]

  gameSystem   GameSystem? @relation(fields: [gameSystemId], references: [id])
  gameSystemId String?     @map("game_system_id")

  useCustomRules Boolean @default(false) @map("use_custom_rules")
  customRules    String? @map("custom_rules")

  locations    CampaignLocation[]
  npcs         CampaignNPC[]
  ruleVariants RuleVariant[]

  sessionOutcomes CampaignSessionOutcome[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("campaigns")
}

model CampaignCharacter {
  id         String   @id @default(cuid(2))
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  player   User   @relation(fields: [playerId], references: [id])
  playerId String @map("player_id")

  name     String
  class    String?
  race     String?
  level    Int?
  isActive Boolean @default(true) @map("is_active")

  experience Int?
  attributes Json?
  inventory  Json?
  notes      String?

  sessions           CharacterSession[]
  gameParticipations GamePlayParticipant[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("campaign_characters")
}

model CampaignLocation {
  id         String   @id @default(cuid(2))
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  name         String
  description  String?
  locationType String? @map("location_type")
  isSecret     Boolean @default(false) @map("is_secret")

  mapImage String? @map("map_image")
  notes    String?

  parentLocation   CampaignLocation?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  parentLocationId String?            @map("parent_location_id")
  childLocations   CampaignLocation[] @relation("LocationHierarchy")

  sessions GamePlaySession[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("campaign_locations")
}

model CampaignNPC {
  id         String   @id @default(cuid(2))
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  name        String
  description String?
  role        String?
  isSecret    Boolean @default(false) @map("is_secret")
  isRecurring Boolean @default(false) @map("is_recurring")

  stats Json?
  notes String?

  appearances CampaignNPCAppearance[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("campaign_npcs")
}

model CampaignNPCAppearance {
  id        String          @id @default(cuid(2))
  npc       CampaignNPC     @relation(fields: [npcId], references: [id])
  npcId     String          @map("npc_id")
  session   GamePlaySession @relation(fields: [sessionId], references: [id])
  sessionId String          @map("session_id")

  role           String?
  wasEncountered Boolean @default(true) @map("was_encountered")
  wasSignificant Boolean @default(false) @map("was_significant")

  significantEvent String? @map("significant_event")
  notes            String?

  @@unique([npcId, sessionId])
  @@map("campaign_npc_appearances")
}

model CharacterSession {
  id                String            @id @default(cuid(2))
  character         CampaignCharacter @relation(fields: [characterId], references: [id])
  characterId       String            @map("character_id")
  gamePlaySession   GamePlaySession   @relation(fields: [gamePlaySessionId], references: [id])
  gamePlaySessionId String            @map("game_play_session_id")

  levelDuringSession Int?    @map("level_during_session")
  experienceGained   Int?    @map("experience_gained")
  notesDuringSession String? @map("notes_during_session")

  @@unique([characterId, gamePlaySessionId])
  @@map("character_sessions")
}

enum CampaignStatus {
  Planning
  Active
  OnHiatus
  Completed
  Abandoned
  Cancelled

  @@map("campaign_statuses")
}

model CampaignMemberPermission {
  id         String   @id @default(cuid(2))
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @map("user_id")

  permission Permission

  grantedBy   User   @relation("CampaignPermissionGranter", fields: [grantedById], references: [id])
  grantedById String @map("granted_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([campaignId, userId, permission])
  @@map("campaign_member_permissions")
}

model CampaignSessionOutcome {
  id                String          @id @default(cuid(2))
  gamePlaySession   GamePlaySession @relation(fields: [gamePlaySessionId], references: [id])
  gamePlaySessionId String          @unique @map("game_play_session_id")

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  storySummary String? @map("story_summary")
  keyDecisions Json?   @map("key_decisions")

  worldChanges Json? @map("world_changes")
  npcChanges   Json? @map("npc_changes")

  treasureFound     Json? @map("treasure_found")
  experienceAwarded Int?  @map("experience_awarded")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("campaign_session_outcomes")
}
