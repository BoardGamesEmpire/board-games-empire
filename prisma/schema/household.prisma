model Household {
  id          String  @id @default(cuid(2))
  description String?
  name        String
  image       String?

  language   Language @relation(fields: [languageId], references: [id])
  languageId String   @map("language_id")

  gamePlaySessions GamePlaySession[]
  members          HouseholdMember[]
  games            HouseholdGame[]
  events           Event[]

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @map("owner_id")

  roleAssignments HouseholdRole[]

  chatRoom ChatRoom?

  campaigns    Campaign[]
  ruleVariants RuleVariant[]

  gameCustomizations HouseholdGameCustomization[]

  accessToGames GameHouseholdAccess[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("households")
}

model HouseholdRole {
  id          String    @id @default(cuid(2))
  household   Household @relation(fields: [householdId], references: [id])
  householdId String    @map("household_id")
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @map("user_id")
  role        Role      @relation(fields: [roleId], references: [id])
  roleId      String    @map("role_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, userId, roleId])
  @@map("household_roles")
}

model HouseholdMember {
  id     String @id @default(cuid(2))
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id])

  showAllGames           Boolean        @default(true) @map("show_all_games")
  excludedFromHouseholds ExcludedGame[]

  gameInterests HouseholdGameInterest[]

  gameExperienceParticipations HouseholdGameExperienceParticipant[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, userId])
  @@map("household_members")
}
