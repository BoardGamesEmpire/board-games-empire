model Game {
  id          String  @id @default(cuid(2))
  title       String
  subtitle    String?
  description String?
  image       String?
  publishYear Int?    @map("publish_year")
  minPlayers  Int?    @map("min_players")
  maxPlayers  Int?    @map("max_players")
  playingTime Int?    @map("playing_time")

  minPlayTime        Int?         @map("min_play_time")
  minPlayTimeMeasure TimeMeasure? @map("min_play_time_measure")
  maxPlayTime        Int?         @map("max_play_time")
  maxPlayTimeMeasure TimeMeasure? @map("max_play_time_measure")
  minAge             Int?         @map("min_age")

  categories GameCategory[]
  mechanics  GameMechanic[]
  families   GameFamily[]
  designers  GameDesigner[]
  artists    GameArtist[]
  publishers GamePublisher[]

  owned       GameCollection[]
  reviews     GameReview[]
  households  HouseholdGame[]
  loanedGames GameLoan[]
  gameLists   GameList[]

  totalPlayCount Int    @default(0) @map("total_play_count")
  averageRating  Float? @map("average_rating")
  complexity     Float?

  ownedByCount Int @default(0) @map("owned_by_count")

  gameMedia GameMedia[]

  eventGames   EventGame[]
  campaigns    Campaign[]
  ruleVariants RuleVariant[]
  playSessions GamePlaySession[]
  tags         GameTag[]

  versions             GameVersion[]
  expansions           GameExpansion[]          @relation("BaseGame")
  compatibleExpansions ExpansionCompatibility[]

  isPrivate      Boolean    @default(false) @map("is_private")
  visibility     Visibility @default(Public)
  createdBy      User?      @relation("GamesCreated", fields: [createdById], references: [id])
  createdById    String?    @map("created_by_id")
  isFromExternal Boolean    @default(false) @map("is_from_external")
  externalId     String?    @map("external_id")

  sharedWithUsers      GameUserAccess[]
  sharedWithHouseholds GameHouseholdAccess[]

  userCustomizations      UserGameCustomization[]
  householdCustomizations HouseholdGameCustomization[]

  weight                 GameWeight?
  implementations        GameImplementation[]
  designerCollaborations GameDesignerCollaboration[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("games")
}

model GameCollection {
  id     String @id @default(cuid(2))
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")
  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  excludedFromHouseholds ExcludedGame[]

  quantity Int @default(1)

  rating      Int?
  playCount   Int?      @map("play_count")
  playAgain   Boolean?  @map("play_again")
  favorite    Boolean?
  comment     String?
  lastPlayed  DateTime? @map("last_played") @db.Timestamptz(3)
  lastUpdated DateTime? @map("last_updated") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, gameId])
  @@map("game_collections")
}

model GameMedia {
  id     String @id @default(cuid(2))
  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  mediaType    MediaType @map("media_type")
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  title        String?
  description  String?
  isDefault    Boolean   @default(false) @map("is_default")

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("game_media")
}

model GameLoan {
  id     String @id @default(cuid(2))
  user   User   @relation("GamesOnLoan", fields: [userId], references: [id])
  userId String @map("user_id")
  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  loanedToUserId String? @map("loaned_to_user_id")
  loanedToUser   User?   @relation("GamesLoanedTo", fields: [loanedToUserId], references: [id])

  // utilize these fields if the individual is not a user in the system
  loanedTo      String? @map("loaned_to")
  loanedToEmail String? @map("loaned_to_email")

  loanDate           DateTime  @default(now()) @map("loan_date") @db.Timestamptz(3)
  expectedReturnDate DateTime? @map("expected_return_date") @db.Timestamptz(3)
  actualReturnDate   DateTime? @map("actual_return_date") @db.Timestamptz(3)
  notes              String?

  @@map("loaned_games")
}

enum TimeMeasure {
  Minutes
  Hours
  Days
  Weeks
  Months
  Years

  @@map("time_measures")
}
