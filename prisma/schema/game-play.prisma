model GamePlaySession {
  id String @id @default(cuid(2))

  event   Event?  @relation(fields: [eventId], references: [id])
  eventId String? @map("event_id")

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?   @map("campaign_id")

  gameVersion   GameVersion? @relation(fields: [gameVersionId], references: [id])
  gameVersionId String?      @map("game_version_id")

  expansionsUsed GamePlaySessionExpansion[]

  rulesUsed RuleVariantUsage[]

  sessionNumber Int?    @map("session_number")
  chapter       String? @map("chapter")
  milestone     String? @map("milestone")

  characterSessions CharacterSession[]

  campaignLocation   CampaignLocation?       @relation(fields: [campaignLocationId], references: [id])
  campaignLocationId String?                 @map("campaign_location_id")
  npcAppearances     CampaignNPCAppearance[]
  sessionOutcome     CampaignSessionOutcome?

  playDate DateTime @default(now()) @map("play_date") @db.Timestamptz(3)
  duration Int?     @map("duration")
  location String?  @map("location")

  context GamePlayContext @default(Casual) @map("context")

  players GamePlayParticipant[]

  results GamePlayResult[]

  household   Household? @relation(fields: [householdId], references: [id])
  householdId String?    @map("household_id")

  venue          String? @map("venue")
  isComplete     Boolean @default(false) @map("is_complete")
  wasInterrupted Boolean @default(false) @map("was_interrupted")

  sessionMedia SessionMedia[]

  playtime Int? @map("playtime")
  turns    Int? @map("turns")

  notes String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("game_play_sessions")
}

enum GamePlayContext {
  Campaign
  Casual
  Competitive
  Convention
  Demo
  League
  OneShot
  OrganizedEvent
  Tournament
  Virtual

  @@map("game_play_contexts")
}

model GamePlayParticipant {
  id String @id @default(cuid(2))

  gamePlaySession   GamePlaySession @relation(fields: [gamePlaySessionId], references: [id])
  gamePlaySessionId String          @map("game_play_session_id")

  // User Association (optional - might be someone without an account)
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @map("user_id")

  guestName String? @map("guest_name")

  campaignCharacter   CampaignCharacter? @relation(fields: [campaignCharacterId], references: [id])
  campaignCharacterId String?            @map("campaign_character_id")

  playerPosition Int?    @map("player_position")
  team           String? @map("team")

  finalScore Float?  @map("final_score")
  placement  Int?    @map("placement")
  winner     Boolean @default(false) @map("winner")

  @@map("game_play_participants")
}

// for complex scoring or multi-phase games
model GamePlayResult {
  id String @id @default(cuid(2))

  gamePlaySession   GamePlaySession @relation(fields: [gamePlaySessionId], references: [id])
  gamePlaySessionId String          @map("game_play_session_id")

  resultType ResultType @default(Score) @map("result_type")

  scoringPhase String? @map("scoring_phase")
  scoreDetails Json?   @map("score_details")

  teamScores        Json? @map("team_scores")
  individualMetrics Json? @map("individual_metrics")

  @@map("game_play_results")
}

model GamePlaySessionExpansion {
  id          String          @id @default(cuid(2))
  session     GamePlaySession @relation(fields: [sessionId], references: [id])
  sessionId   String          @map("session_id")
  expansion   GameExpansion   @relation(fields: [expansionId], references: [id])
  expansionId String          @map("expansion_id")

  @@unique([sessionId, expansionId])
  @@map("game_play_session_expansions")
}

enum ResultType {
  Custom
  Elimination
  Placement
  Points
  Score
  Time

  @@map("result_types")
}
