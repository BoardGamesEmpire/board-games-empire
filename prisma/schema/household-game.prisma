model HouseholdGame {
  id          String    @id @default(cuid(2))
  household   Household @relation(fields: [householdId], references: [id])
  householdId String    @map("household_id")
  game        Game      @relation(fields: [gameId], references: [id])
  gameId      String    @map("game_id")

  ownershipType HouseholdGameOwnership @default(MemberOwned) @map("ownership_type")

  storageLocation String?        @map("storage_location")
  condition       GameCondition? @map("condition")
  missingPieces   String?        @map("missing_pieces")

  houseRating     Float?    @map("house_rating")
  playCount       Int       @default(0) @map("play_count")
  lastPlayed      DateTime? @map("last_played") @db.Timestamptz(3)
  isFavorite      Boolean   @default(false) @map("is_favorite")
  bestPlayerCount Int?      @map("best_player_count")

  isAvailable       Boolean @default(true) @map("is_available")
  unavailableReason String? @map("unavailable_reason")

  championedBy   User?   @relation("GameChampion", fields: [championedById], references: [id])
  championedById String? @map("championed_by_id")

  maintainedBy   User?   @relation("GameKeeper", fields: [maintainedById], references: [id])
  maintainedById String? @map("maintained_by_id")

  teacherId String? @map("teacher_id")
  teacher   User?   @relation("GameTeacher", fields: [teacherId], references: [id])

  mostFrequentWinner String? @map("most_frequent_winner")
  winHistory         Json?   @map("win_history")

  playerDynamics PlayerDynamic[]

  idealFor GameNightType[] @map("ideal_for")

  memberInterest HouseholdGameInterest[]

  learningDifficulty LearningDifficulty? @map("learning_difficulty")
  teachingNotes      String?             @map("teaching_notes")

  houseRuleCount Int @default(0) @map("house_rule_count")

  notes           String?
  gameExperiences HouseholdGameExperience[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, gameId])
  @@map("household_games")
}

enum HouseholdGameOwnership {
  Borrowed
  Digital
  HouseholdOwned
  MemberOwned

  @@map("household_game_ownerships")
}

model HouseholdGameCustomization {
  id          String    @id @default(cuid(2))
  household   Household @relation(fields: [householdId], references: [id])
  householdId String    @map("household_id")
  game        Game      @relation(fields: [gameId], references: [id])
  gameId      String    @map("game_id")

  title       String? @map("title")
  subtitle    String? @map("subtitle")
  description String? @map("description")
  image       String? @map("image")
  publishYear Int?    @map("publish_year")
  minPlayers  Int?    @map("min_players")
  maxPlayers  Int?    @map("max_players")
  playingTime Int?    @map("playing_time")
  minPlayTime Int?    @map("min_play_time")
  maxPlayTime Int?    @map("max_play_time")
  minAge      Int?    @map("min_age")
  complexity  Float?  @map("complexity")

  customizedBy   User   @relation(fields: [customizedById], references: [id])
  customizedById String @map("customized_by_id")

  customizationNotes String? @map("customization_notes")

  permissions HouseholdGameCustomizationPermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdId, gameId])
  @@map("household_game_customizations")
}

model HouseholdGameExperience {
  id              String        @id @default(cuid(2))
  householdGame   HouseholdGame @relation(fields: [householdGameId], references: [id])
  householdGameId String        @map("household_game_id")

  date        DateTime @default(now()) @db.Timestamptz(3)
  title       String
  description String

  participants HouseholdGameExperienceParticipant[]

  // TODO: media model
  photos String[]

  tags String[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("household_game_experiences")
}

model HouseholdGameExperienceParticipant {
  id String @id @default(cuid(2))

  experience   HouseholdGameExperience @relation(fields: [experienceId], references: [id])
  experienceId String                  @map("experience_id")

  member   HouseholdMember @relation(fields: [memberId], references: [id])
  memberId String          @map("member_id")

  role          String?
  hadFun        Boolean? @map("had_fun")
  notes         String?
  isHighlighted Boolean  @default(false) @map("is_highlighted")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([experienceId, memberId])
  @@map("household_game_experience_participants")
}

model HouseholdGameInterest {
  id                String          @id @default(cuid(2))
  householdGame     HouseholdGame   @relation(fields: [householdGameId], references: [id])
  householdGameId   String          @map("household_game_id")
  member            HouseholdMember @relation(fields: [householdMemberId], references: [id])
  householdMemberId String          @map("household_member_id")

  interestLevel InterestLevel @default(Neutral) @map("interest_level")
  playDesire    PlayDesire    @default(Anytime) @map("play_desire")

  // TODO: separate model?
  comments String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([householdGameId, householdMemberId])
  @@map("household_game_interests")
}

model HouseholdGameCustomizationPermission {
  id              String                     @id @default(cuid(2))
  customization   HouseholdGameCustomization @relation(fields: [customizationId], references: [id])
  customizationId String                     @map("customization_id")
  user            User                       @relation(fields: [userId], references: [id])
  userId          String                     @map("user_id")

  permission Permission

  grantedBy   User   @relation("HouseholdCustomizationPermissionGranter", fields: [grantedById], references: [id])
  grantedById String @map("granted_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([customizationId, userId, permission])
  @@map("household_game_customization_permissions")
}
