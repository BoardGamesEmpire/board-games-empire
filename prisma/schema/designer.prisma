model Designer {
  id String @id @default(cuid(2))

  name      String  @unique
  fullName  String? @map("full_name")
  website   String?
  biography String?
  country   String?

  boardGameGeekUrl String? @map("board_game_geek_url")
  debutYear        Int?    @map("debut_year")

  collaborators    DesignerCollaboration[] @relation("PrimaryDesigner")
  collaboratedWith DesignerCollaboration[] @relation("Collaborator")

  totalCollaborators         Int?    @map("total_collaborators")
  mostFrequentCollaboratorId String? @map("most_frequent_collaborator_id")

  games GameDesigner[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("designers")
}

model GameDesigner {
  id String @id @default(cuid(2))

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  designer   Designer @relation(fields: [designerId], references: [id])
  designerId String   @map("designer_id")

  role DesignerRole @default(Primary)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gameId, designerId])
  @@map("game_designers")
}

model DesignerCollaboration {
  id String @id @default(cuid(2))

  primaryDesigner   Designer @relation("PrimaryDesigner", fields: [primaryDesignerId], references: [id])
  primaryDesignerId String   @map("primary_designer_id")

  collaborator   Designer @relation("Collaborator", fields: [collaboratorId], references: [id])
  collaboratorId String   @map("collaborator_id")

  collaborationCount  Int  @default(1) @map("collaboration_count")
  firstCollaboration  Int? @map("first_collaboration")
  latestCollaboration Int? @map("latest_collaboration")

  gameCollaborations GameDesignerCollaboration[]

  strength Float?
  notes    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([primaryDesignerId, collaboratorId])
  @@index([primaryDesignerId])
  @@index([collaboratorId])
  @@map("designer_collaborations")
}

enum DesignerRole {
  Primary
  Secondary
  Developer
  Contributor

  @@map("designer_roles")
}

model GameDesignerCollaboration {
  id String @id @default(cuid(2))

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @map("game_id")

  designerCollaboration   DesignerCollaboration @relation(fields: [designerCollaborationId], references: [id])
  designerCollaborationId String                @map("designer_collaboration_id")

  notes            String?
  contributionType String? @map("contribution_type")
  year             Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gameId, designerCollaborationId])
  @@index([gameId])
  @@index([designerCollaborationId])
  @@map("game_designer_collaborations")
}
