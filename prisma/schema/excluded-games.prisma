model ExcludedGame {
  id String @id @default(cuid(2))

  // HouseholdMember relationship
  householdMember   HouseholdMember @relation(fields: [householdMemberId], references: [id])
  householdMemberId String

  // GameCollection relationship
  gameCollection   GameCollection @relation(fields: [gameCollectionId], references: [id])
  gameCollectionId String

  // Optional: Add additional metadata for the relationship
  excludedReason String?
  excludedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([householdMemberId, gameCollectionId]) // Ensure one relationship per game/member pair
  @@map("excluded_games") // Database table name
}
